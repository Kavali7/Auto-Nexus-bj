generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Dealer {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  city          String
  phone         String?
  whatsapp      String?
  email         String?
  headline      String?
  description   String?
  foundedYear   Int?
  staffCount    Int?
  rating        Float?
  ratingCount   Int?
  logo          String?
  address       String?
  specialties   String[]  @default([])
  website       String?
  instagram     String?
  facebook      String?
  linkedin      String?
  inventorySize Int?
  heroImage     String?
  gallery       String[]  @default([])
  inventory     Vehicle[]
  leads         Lead[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Vehicle {
  id            String         @id @default(cuid())
  slug          String         @unique
  dealerId      String
  dealer        Dealer         @relation(fields: [dealerId], references: [id])
  brand         String
  model         String
  trim          String?
  year          Int
  condition     String
  mileage       Int
  mileageUnit   String         @default("km")
  fuel          String
  transmission  String
  drivetrain    String?
  price         Int
  currency      String         @default("XOF")
  city          String
  doors         Int?
  colorExterior String?
  colorInterior String?
  featured      Boolean        @default(false)
  specs         Json           @default("[]")
  heroImage     String?
  virtualTourUrl String?
  gallery       VehiclePhoto[]
  highlights    String[]
  available     Boolean        @default(true)
  leads         Lead[]
  uploads       Upload[]
  favorites     Favorite[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  url       String
  label     String?
  position  Int      @default(0)
  kind      VehicleMediaKind @default(STANDARD)
  createdAt DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  dealerId  String
  dealer    Dealer     @relation(fields: [dealerId], references: [id])
  vehicleId String?
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id])
  name      String
  phone     String
  message   String
  source    String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  bucket    String   @default("public-assets")
  path      String
  url       String
  mimeType  String?
  bytes     Int?
  width     Int?
  height    Int?
  tags      String[]
  metadata  Json?
  createdAt DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  visitorId  String
  visitor    Visitor  @relation(fields: [visitorId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([visitorId, vehicleId])
}

model Visitor {
  id           String           @id @default(cuid())
  sessionToken String           @unique
  favorites    Favorite[]
  analytics    AnalyticsEvent[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id])
  event     String
  payload   Json?
  createdAt DateTime @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum VehicleMediaKind {
  STANDARD
  EXTERIOR
  INTERIOR
  DETAIL
  PANORAMA
  WALKAROUND
}
