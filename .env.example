# Meilisearch configuration
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Supabase configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
SUPABASE_STORAGE_BUCKET="public-assets"
# Optional CDN override (utilisez SUPABASE_CDN_URL ou SUPABASE_CDN_HOSTNAME)
SUPABASE_CDN_URL="https://cdn.autonexus.bj"
# SUPABASE_CDN_HOSTNAME="cdn.autonexus.bj"
# SUPABASE_CDN_PROTOCOL="https"

# Public site URL (utilisé pour metadataBase Next.js)
NEXT_PUBLIC_SITE_URL="https://auto-nexus.bj"

# Database (Prisma) configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autonexus?schema=public"

# Demo / static export mode
NEXT_PUBLIC_STATIC_DEMO_MODE="false"
STATIC_DEMO_MODE="false"
